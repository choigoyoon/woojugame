{
  "name": "uju-block-arcade",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/pwa.mjs && node scripts/build.mjs",
    "test": "node --test",
    "test:browser": "npm run build && python3 tests/browser_check.py",
    "test:visual": "npm run build && python3 tests/visual_check.py",
    "test:campaign": "npm run build && python3 tests/campaign_browser_check.py",
    "pwa": "node scripts/pwa.mjs",
    "icons": "python3 scripts/icons.py",
    "test:production": "npm run build && python3 tests/production_browser_check.py",
    "test:pwa": "npm run pwa && python3 tests/pwa_check.py",
    "test:audio": "npm run build && python3 tests/audio_audit.py && python3 tests/audio_plot.py",
    "test:audit": "npm run build && python3 tests/visual_audit.py",
    "test:fuzz": "npm run build && python3 tests/polish_fuzz.py",
    "test:frame-budget": "npm run build && node --test tests/frame-budget.test.js && python3 tests/frame_budget_browser.py",
    "test:render-workload": "npm run build && python3 tests/render_workload.py",
    "test:performance": "npm run build && python3 tests/polish_performance.py"
  },
  "engines": {
    "node": ">=20"
  }
}
